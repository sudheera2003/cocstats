# Copy to .env for local development. On Render, set these in the service's Environment tab.

# Your clan's tag. The leading # is optional; in a .env file leave it off (or quote
# the value), because an unquoted # starts a comment.
CLAN_TAG=2PP0JCCL

# API key from https://developer.clashofclans.com (My Account -> Create New Key).
# A key only works from the IP addresses it was created for: open /api/ip on the
# running backend to see which address to allow.
COC_API_TOKEN=

# Optional. Serve generated sample data instead of calling the real API, for
# working on the app without a key.
# COC_MOCK=1

# Optional. Where the Clash of Clans API is reached.
# COC_API_BASE_URL=https://api.clashofclans.com/v1

# Optional. Comma-separated browser origins allowed to call this API. Any origin
# is allowed when unset; the frontend calls it server-side, so CORS rarely matters.
# CORS_ORIGIN=https://your-frontend.example.com

# Optional. Render sets PORT itself.
# PORT=4000
